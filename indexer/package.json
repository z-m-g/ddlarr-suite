{
  "name": "ddl-torznab",
  "version": "1.3.2",
  "description": "Torznab indexer for DDL sites (WawaCity, Zone-Téléchargement, DarkiWorld, Bookys, Loadix)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "torznab",
    "prowlarr",
    "sonarr",
    "radarr",
    "ddl",
    "indexer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": ">=1.7.9 <1.20.1",
    "bencode": "^4.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/bencode": "^4.0.0",
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
